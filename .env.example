# Copy this file to .env for local development.
# Replace the key with a unique value; never commit the .env file.
DJANGO_SECRET_KEY=replace-with-a-unique-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. Leave DB_NAME unset to use local SQLite.
# To use PostgreSQL, set all five DB_* values in your local .env.
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Optional Razorpay test credentials. Payments stay disabled without keys and a positive fee.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BOOKING_FEE_PAISE=0
RAZORPAY_CURRENCY=INR
